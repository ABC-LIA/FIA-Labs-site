{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260610-beta"
  },
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/assets/(.*)"
    },
    {
      "src": "^/lia/?$",
      "status": 308,
      "headers": {
        "Location": "/work/lia"
      }
    },
    {
      "src": "^/pricing/?$",
      "status": 308,
      "headers": {
        "Location": "/work"
      }
    },
    {
      "src": "^/apps/?$",
      "status": 308,
      "headers": {
        "Location": "/work"
      }
    },
    {
      "src": "^/pricing-philosophy/?$",
      "status": 308,
      "headers": {
        "Location": "/company"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}
